DOCKER_REGISTRY ?= docker.io
IMAGE ?= $(DOCKER_REGISTRY)/bborbe/$(SERVICE)

# local = plain `docker build` on this machine. Anything else is a kubectl
# context that resolves through hack/cluster-alias.sh, and the build runs as a
# BuildKit Job in that cluster instead.
BUILD_TARGET ?= local

# Cluster arm inputs. REF must be a full 40-character SHA: the Job clones it
# shallowly, and a short SHA fails there with `couldn't find remote ref`.
BUILD_REF ?= $(shell git rev-parse HEAD)
BUILD_DOCKERFILE ?= Dockerfile
BUILD_NAMESPACE ?= build
BUILD_REPO_URL ?= https://github.com/bborbe/sentry-watcher.git
BUILD_PUSH_SECRET ?= buildkit-push
BUILD_TIMEOUT ?= 3600

# Remember whether VERSION came from the default below: the cluster arm refuses
# a defaulted VERSION, because it resolves to the newest release tag and would
# overwrite that release.
ifeq ($(VERSION),)
VERSION_DEFAULTED := 1
VERSION := $(shell git describe --tags `git rev-list --tags --max-count=1`)
endif

# Rendered here so `make -n` shows the sanitized name rather than the raw tag.
# DNS-1123: lowercase, everything outside [a-z0-9.-] replaced with '-', at most
# 63 characters, no trailing '-' or '.'.
JOB_NAME := $(shell printf '%s' 'build-$(VERSION)' | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9.-]/-/g' | cut -c1-63 | sed -e 's/[-.]*$$//')

ifeq ($(BUILD_TARGET),local)

.PHONY: build
build: check-version-tag check-go-mod
	@if [ -z "$(VERSION)" ]; then echo "ERROR: no VERSION set and no git tag found — set VERSION=vX.Y.Z or create a tag" >&2; exit 1; fi
	DOCKER_BUILDKIT=1 \
	docker build \
	--pull \
	--no-cache \
	--rm=true \
	--platform=linux/amd64 \
	--build-arg DOCKER_REGISTRY=$(DOCKER_REGISTRY) \
	--build-arg BUILD_GIT_COMMIT=$$(git rev-parse --short HEAD) \
	--build-arg BUILD_DATE=$$(date -u +%Y-%m-%dT%H:%M:%SZ) \
	-t $(IMAGE):$(VERSION) \
	-f $(BUILD_DOCKERFILE) .

.PHONY: check-version-tag
check-version-tag:
	@if [ -n "$(ALLOW_UNTAGGED_BUILD)" ]; then \
		echo "ALLOW_UNTAGGED_BUILD set — skipping version/tag check"; \
	else \
		head_tag=$$(git describe --tags --exact-match HEAD 2>/dev/null); \
		if [ "$$head_tag" != "$(VERSION)" ]; then \
			echo "ERROR: refusing to build $(VERSION) from this tree." >&2; \
			echo "  HEAD is at tag: $${head_tag:-<untagged>}" >&2; \
			echo "  building as:    $(VERSION)" >&2; \
			echo "  An image stamped vX.Y.Z must be built from the vX.Y.Z tag." >&2; \
			echo "  Fix: git checkout $(VERSION)   (or set ALLOW_UNTAGGED_BUILD=1 for a scratch build)" >&2; \
			exit 1; \
		fi; \
	fi

.PHONY: check-go-mod
check-go-mod:
	@if [ -f "go.mod" ]; then \
		echo "go.mod found, running go mod vendor..."; \
		go mod vendor; \
	else \
		echo "go.mod not found, skipping go mod vendor."; \
	fi

else

# The cluster arm. The two guards above are prerequisites of the LOCAL target
# only: a scratch-tag build would fail check-version-tag before any Job
# rendered, and `go mod vendor` on this machine is meaningless for a build that
# happens in a pod.
.PHONY: build
build:
	@if [ -n "$(VERSION_DEFAULTED)" ]; then \
		echo "ERROR: BUILD_TARGET=$(BUILD_TARGET) needs an explicit VERSION." >&2; \
		echo "  The Makefile default resolves to the newest release tag ($(VERSION)), and" >&2; \
		echo "  building it from an arbitrary REF would overwrite that release." >&2; \
		echo "  Fix: make build BUILD_TARGET=$(BUILD_TARGET) REF=<40-char-sha> VERSION=<tag>" >&2; \
		exit 1; \
	fi
	BUILD_TARGET="$(BUILD_TARGET)" \
	NAMESPACE="$(BUILD_NAMESPACE)" \
	REPO_URL="$(BUILD_REPO_URL)" \
	REF="$(BUILD_REF)" \
	TAG="$(VERSION)" \
	DOCKERFILE="$(BUILD_DOCKERFILE)" \
	IMAGE="$(IMAGE)" \
	PUSH="true" \
	PUSH_SECRET="$(BUILD_PUSH_SECRET)" \
	TIMEOUT="$(BUILD_TIMEOUT)" \
	DOCKER_REGISTRY="$(DOCKER_REGISTRY)" \
	JOB_NAME="$(JOB_NAME)" \
	./hack/build-cluster.sh

endif

.PHONY: upload
upload:
ifeq ($(BUILD_TARGET),local)
	docker push $(IMAGE):$(VERSION)
else
	@echo "upload: skipped for BUILD_TARGET=$(BUILD_TARGET) — the Job already pushed $(IMAGE):$(VERSION)"
endif

.PHONY: clean
clean:
ifeq ($(BUILD_TARGET),local)
	docker rmi $(IMAGE):$(VERSION) || true
	docker image prune -f || true
	docker builder prune --all -f || true
	rm -rf vendor
else
	@echo "clean: skipped for BUILD_TARGET=$(BUILD_TARGET) — no local image was produced"
endif

# Publish-only: no k8s in this repo. Deployment lives in the maintainer Helm
# chart (mirror + keel-pattern). apply is a no-op placeholder.
.PHONY: apply
apply:
	@echo "skip apply — publish-only"

# Operator-run publish to Docker Hub (requires `docker login`). CI runs
# `make precommit`, never `buca`, so the unconditional push is safe.
.PHONY: buca
buca: build upload clean apply
